# syntax=docker/dockerfile:1.7

ARG ASSETS_IMAGE=chia-runtime200-assets:local
ARG BASE_IMAGE=chia-runtime200-base:local
FROM ${ASSETS_IMAGE} AS assets
FROM ${BASE_IMAGE}

ARG NODE_ID
ARG NODE_ROLE

ENV NODE_ID=${NODE_ID} \
    NODE_NAME=node${NODE_ID} \
    NODE_ROLE=${NODE_ROLE}

RUN --mount=type=bind,from=assets,source=/opt/chia,target=/mnt/chia,readonly \
    set -eux; \
    test -n "${NODE_ID}"; \
    test -n "${NODE_ROLE}"; \
    mkdir -p /opt/chia/node-ssl /opt/chia/plots; \
    cp -a "/mnt/chia/certs/node${NODE_ID}/ssl/." /opt/chia/node-ssl/; \
    if [ "${NODE_ROLE}" = farmer ]; then \
      cp -a "/mnt/chia/plots/node${NODE_ID}/." /opt/chia/plots/; \
    fi

ENTRYPOINT ["/usr/bin/tini", "--", "/usr/local/bin/chia-entrypoint"]
